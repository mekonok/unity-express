rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    // Group admin adds approved users here manually in the Firebase Console.
    // Document ID must be the user's Firebase Authentication UID; field: active = true.
    match /members/{uid} {
      allow read: if activeMember() && request.auth.uid == uid;
      allow write: if false;
    }

    match /deposits/{entryId} {
      allow read: if activeMember();
      allow create: if activeMember()
        && request.resource.data.keys().hasOnly(['member', 'amount', 'date', 'note', 'createdBy', 'createdAt'])
        && request.resource.data.member is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /expenses/{entryId} {
      allow read: if activeMember();
      allow create: if activeMember()
        && request.resource.data.keys().hasOnly(['description', 'amount', 'date', 'recorder', 'createdBy', 'createdAt'])
        && request.resource.data.description is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
